# Porta do servidor (Render/Fly definem isso automaticamente)
PORT=3000

# --- HTTPS local (opcional) ---
# Defina como 1 para o servidor subir em HTTPS usando os certificados em ./certs
# Veja o README, secao "Rodando com HTTPS local".
MESHMEET_HTTPS=0
SSL_CERT_FILE=./certs/cert.pem
SSL_KEY_FILE=./certs/key.pem

# --- TURN (opcional, mas MUITO recomendado para uso pela internet) ---
# Sem TURN, participantes atras de NAT simetrico / CGNAT podem nao conseguir
# conectar entre si. Veja o README, secao "Sobre o TURN".
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
